<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - NewWorky</title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <figure>
        <form class="login-form">

            <img class="logo" src="/imagens/Logo NewWorky.svg" alt="Logo NewWorky">

            <h1>Bem-vindo de volta!</h1>
            <p>Faça login para acessar sua conta</p>

            <input type="email" placeholder="E-mail">
            <br>

            <input type="password" id="uePassowrd" placeholder="Senha">
            <button class="submit-eye" type="button" onclick="mostrarSenha()">
        <i id="ueEyePass" class="fa fa-eye"></i>
    </button>
            <br>

            <button class="btn-login" type="submit">
                Entrar
            </button>

            <div class="divisor">
                <span></span>
                <p>ou continue com</p>
                <span></span>
            </div>

            <p class="cadastro">
                Não tem uma conta?
                <a href="/cadastro">Cadastre-se</a>
            </p>

        </form>
    </figure>

    <script src="/js/login.js"></script>
</body>

</html>